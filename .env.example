# Copier ce fichier en ".env" (cp .env.example .env). Le vrai .env n'est JAMAIS versionné.

# --- Lancement local SANS Docker (API sur votre machine) ---
# En Docker Compose, cette valeur est remplacée par http://api:8000/metrics
# (dans un conteneur, 127.0.0.1 désigne le conteneur lui-même, pas l'API).
METRICS_ENDPOINT=http://127.0.0.1:8000/metrics

# Intervalle entre deux collectes, en secondes
COLLECTION_INTERVAL=5

# Timeout HTTP en secondes
REQUEST_TIMEOUT=5

# --- Optionnel : SonarQube local (docker-compose.sonarqube.yml) ---
# SONAR_DB_PASSWORD=choisissez-un-mot-de-passe
